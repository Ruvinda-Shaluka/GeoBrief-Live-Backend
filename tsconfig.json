{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",              /* Tells TS to output modern Node ESM */
    "moduleResolution": "NodeNext",    /* Tells TS to resolve imports the Node ESM way */
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "exclude": ["api", "dist", "node_modules"]
}